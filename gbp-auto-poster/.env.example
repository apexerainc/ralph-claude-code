# Google Business Profile Auto-Poster Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# =============================================================================
# REQUIRED: Google Credentials
# =============================================================================

# Your Google account email
GOOGLE_EMAIL=your-email@gmail.com

# Your Google account password
# IMPORTANT: If you have 2-Step Verification enabled, use an App Password instead
# Create one at: https://myaccount.google.com/apppasswords
GOOGLE_PASSWORD=your-password-or-app-password

# Your Google Business Profile name (as it appears in Google)
BUSINESS_NAME=Your Business Name

# =============================================================================
# OPTIONAL: Scheduler Settings
# =============================================================================

# Cron expression for scheduling (default: every day at 9:00 AM)
# Format: minute hour day month weekday
# Examples:
#   0 9 * * *      = Every day at 9:00 AM
#   0 9,18 * * *   = Every day at 9:00 AM and 6:00 PM
#   0 9 * * 1-5    = Weekdays at 9:00 AM
#   0 12 * * 1     = Every Monday at noon
SCHEDULE_CRON=0 9 * * *

# Timezone for the scheduler (default: America/New_York)
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/New_York

# =============================================================================
# OPTIONAL: Browser Settings
# =============================================================================

# Run browser in headless mode (default: true)
# Set to false for debugging or to handle 2FA manually
HEADLESS=true

# Slow down browser actions by this many milliseconds (default: 0)
# Useful for debugging
SLOW_MO=0

# Default timeout for operations in milliseconds (default: 30000)
TIMEOUT=30000

# =============================================================================
# OPTIONAL: Retry Settings
# =============================================================================

# Maximum number of retry attempts on failure (default: 3)
MAX_RETRIES=3

# Initial delay between retries in milliseconds (default: 5000)
# Uses exponential backoff: delay * 2^(attempt-1)
RETRY_DELAY=5000

# =============================================================================
# OPTIONAL: Default Post Content
# =============================================================================

# Default post text (used if no posts.json file exists)
DEFAULT_POST_TEXT=Check out our latest updates! Visit us today for great service.

# Default call-to-action button URL
DEFAULT_BUTTON_URL=https://your-website.com

# Default call-to-action button text
DEFAULT_BUTTON_TEXT=Learn More

# =============================================================================
# OPTIONAL: Logging
# =============================================================================

# Log level: error, warn, info, debug (default: info)
LOG_LEVEL=info

# Path to log file (default: logs/gbp-poster.log)
LOG_FILE=logs/gbp-poster.log
